---
import Hero from "../components/hero/hero.astro";
import Menu from "../components/menu/menu-single-page.astro";
import Testimonials from "../components/testimonials/testimonials.astro";
import Reservation from "../components/reservation/reservation.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { MENU_SECTIONS as menuSections } from "../data/menu";
---

<BaseLayout>
  <Fragment slot="main">
    <Hero />
    <Menu sections={menuSections} />
    <Testimonials />
    <Reservation />
  </Fragment>
</BaseLayout>
