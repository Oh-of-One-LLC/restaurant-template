---
import "../styles/global.css";
import Header from "../components/header.astro";
import Footer from "../components/footer/footer.astro";
import { COMPANY_NAME as companyName, PHONE as phone } from "../config";

const menuItems = [
  {
    name: "Menu",
    href: "/#menu",
  },
  {
    name: "Reservations",
    href: "/#reservations",
  },
];

const logo = companyName;

const { pageTitle = companyName } = Astro.props;
---

<!doctype html>
<html lang="en" class="h-full scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta
      name="description"
      content="Handcrafted Neapolitan pizza from a 900° oak-fired oven."
    />
    <meta name="theme-color" content="#1a0f07" />
  </head>

  <body class="bg-background text-text min-h-full antialiased">
    <div class="flex min-h-screen flex-col" id="top">
      <Header logo={logo} menuItems={menuItems} />

      <main class="max-w-90vw flex-1" role="main">
        <slot name="main" />
      </main>

      <Footer companyName={companyName} phone={phone} />
    </div>
  </body>
</html>
